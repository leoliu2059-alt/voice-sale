# Local-only secrets. Do not commit supabase/functions/.env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# JSON dictionary used for backend-only keys. Keep the active key under
# "service_role"; this permits a controlled rotation to additional key IDs.
SUPABASE_SECRET_KEYS={"service_role":"your-service-role-key"}

# OpenAI audio transcription. whisper-1 supports verbose_json timestamps.
OPENAI_TRANSCRIPTION_API_KEY=replace-with-openai-api-key
OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Any OpenAI-compatible /chat/completions provider. Example DeepSeek URL:
# https://api.deepseek.com/v1 (with ANALYSIS_MODEL=deepseek-chat).
ANALYSIS_API_KEY=replace-with-provider-api-key
ANALYSIS_BASE_URL=https://api.openai.com/v1
ANALYSIS_MODEL=gpt-4o-mini
